# Copiá este archivo a .env.local y completá los valores.
# En Vercel: Project → Settings → Environment Variables (Production y Preview).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: cron de notificaciones, invitaciones, borrar cuenta. Nunca al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Notificaciones push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com
# Lo manda pg_cron en el header x-cron-secret a /api/push/cron.
CRON_SECRET=

# --- Lectura de comprobantes con IA (opcional; con una alcanza) ---
# Sin ninguna, las capturas quedan para completar a mano.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Lecturas con IA por usuario cada 24 h.
CAPTURE_DAILY_LIMIT=40

# --- Varios ---
# Quién ve el link a /como-funciona en Ajustes.
ADMIN_EMAIL=
